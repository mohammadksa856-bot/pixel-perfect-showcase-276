From a427572a2609b2878277a74c37bb1c9a62f69654 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 11:46:03 +0000
Subject: [PATCH 1/3] CI: guard the dormant ARAMCO95 projection kernel on
 Ubuntu and Windows

Adds an independent workflow scoped to the kernel files, the synthetic
sha-pinned fixtures, their generator, .gitattributes and the trust store.
Actions are pinned to commit SHAs, Bun to 1.4.2; the token is read-only
and no secret is used. Windows checks out with core.autocrlf=true.
Order: sha pins, the 34 kernel tests before any generation, tsc, ESLint
on the kernel files, build, the generator twice with a clean tree, pins
again, empty trust store, and a secret and real-data scan of the test data.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CfTpoii6QDStyTPdotmEdY
---
 .github/scripts/aramco95-kernel-checks.ts | 138 ++++++++++++++++++++++
 .github/workflows/aramco95-kernel.yml     | 137 +++++++++++++++++++++
 2 files changed, 275 insertions(+)
 create mode 100644 .github/scripts/aramco95-kernel-checks.ts
 create mode 100644 .github/workflows/aramco95-kernel.yml

diff --git a/.github/scripts/aramco95-kernel-checks.ts b/.github/scripts/aramco95-kernel-checks.ts
new file mode 100644
index 0000000..5773b52
--- /dev/null
+++ b/.github/scripts/aramco95-kernel-checks.ts
@@ -0,0 +1,138 @@
+// CI checks of the dormant ARAMCO95 financial projection kernel (workflow aramco95-kernel.yml).
+// Usage: bun .github/scripts/aramco95-kernel-checks.ts <pins|trust|scan>
+//   pins  - the sha-pinned files are LF on this checkout and hash to the values pinned in the baseline and here.
+//   trust - the publication trust store has no authority, so no publication decision can verify.
+//   scan  - the synthetic test data carries no secret, private record or real-looking value, source or issuer.
+// Every check prints one PASS/FAIL line; the process exits non-zero if any fails.
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+
+const FIXTURES = ["9901", "9902", "9903"].map(
+  (s) => `tests/fixtures/synthetic-projection/${s}-page.json`,
+);
+const BASELINE = "src/lib/engine/publication-baseline.json";
+const TRUST = "src/lib/engine/publication-trust.json";
+const GENERATOR = "tests/fixtures/synthetic-projection/generate.ts";
+const TEST = "tests/financial-projection.test.ts";
+// Pinned at the accepted candidate c43f6ba. Changing test data means changing these in the same reviewed commit.
+const PINNED: Record<string, string> = {
+  [FIXTURES[0]]: "7a3a5f9606d2b9d3052f57f2c682e811eecf391674e87ad7551242bff52ce093",
+  [FIXTURES[1]]: "323e4d242d88d71497757e70a12714f69f1110eaaa6341edd076291fe6c66c81",
+  [FIXTURES[2]]: "0a48c331b72503b3bee65fdaa48e997a868d05f966ff3cad5f65040ac28f9302",
+  [BASELINE]: "a2ed6c7ed36cf554755ab4770060a555ee593cdbc00b149e6583e14c56caea65",
+};
+const SECRETS: [string, RegExp][] = [
+  ["private key", /-----BEGIN [A-Z ]*PRIVATE KEY-----/],
+  ["JWT", /eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\./],
+  ["OpenAI-style key", /\bsk-[A-Za-z0-9]{20,}/],
+  ["AWS access key", /\bAKIA[0-9A-Z]{16}\b/],
+  ["GitHub token", /\bgh[pousr]_[A-Za-z0-9]{30,}/],
+  ["Supabase service role", /service_role/],
+  ["Vercel token or env", /VERCEL_(TOKEN|OIDC)|vercel_blob_rw_/i],
+  ["embedded PDF", /%PDF-/],
+  [
+    "private T1 record",
+    /T1-SOURCE-REVIEW-RECEIPT|T1-AUTHORIZATION\.json|T1-INDEPENDENT-SOURCE-REVIEW/,
+  ],
+  ["QB3/QB4 record", /\bQB[34]\b/],
+];
+
+const results: [string, boolean, string?][] = [];
+const check = (name: string, ok: boolean, detail?: string) => results.push([name, ok, detail]);
+const sha256 = (path: string) => createHash("sha256").update(readFileSync(path)).digest("hex");
+
+function pins() {
+  for (const path of [...FIXTURES, BASELINE]) {
+    check(`${path} has no CR byte`, !readFileSync(path).includes(13));
+    const got = sha256(path);
+    check(`${path} sha256 = pinned`, got === PINNED[path], got);
+  }
+  const baseline = JSON.parse(readFileSync(BASELINE, "utf8"));
+  FIXTURES.forEach((path, i) => {
+    const symbol = ["9901", "9902", "9903"][i];
+    check(
+      `baseline pins ${symbol} to the checked-out fixture`,
+      baseline.fixtures?.[symbol] === sha256(path),
+    );
+  });
+}
+
+function trust() {
+  const store = JSON.parse(readFileSync(TRUST, "utf8"));
+  check(
+    "trust store schema is marefa-publication-trust/1",
+    store.schema === "marefa-publication-trust/1",
+  );
+  check(
+    "trust store authorities is an empty array",
+    Array.isArray(store.authorities) && store.authorities.length === 0,
+  );
+  check(
+    "trust store carries no key material",
+    !/[A-Za-z0-9+/]{40,}={0,2}|-----BEGIN/.test(JSON.stringify(store)),
+  );
+}
+
+function scan() {
+  const files = [...FIXTURES, BASELINE, GENERATOR, TEST, TRUST];
+  for (const path of files) {
+    const text = readFileSync(path, "utf8");
+    const hits = SECRETS.filter(([, re]) => re.test(text)).map(([n]) => n);
+    check(`${path}: no secret or private record`, hits.length === 0, hits.join(", "));
+    const hosts = [...new Set([...text.matchAll(/https?:\/\/([^/\s"'`]+)/g)].map((m) => m[1]))];
+    // The test points the kernel at stub engines; both hosts are unresolvable (reserved .test TLD, single label).
+    const allowed = path === TEST ? ["example.invalid", "engine.test", "e"] : ["example.invalid"];
+    check(
+      `${path}: URLs only on reserved hosts`,
+      hosts.every((h) => allowed.includes(h)),
+      hosts.join(", "),
+    );
+  }
+  for (const path of FIXTURES) {
+    const page = JSON.parse(readFileSync(path, "utf8"));
+    const values = new Set<string>();
+    const names = new Set<string>();
+    const walk = (x: unknown, key?: string) => {
+      if (Array.isArray(x)) x.forEach((v) => walk(v, key));
+      else if (x && typeof x === "object") Object.entries(x).forEach(([k, v]) => walk(v, k));
+      else if (key === "value" && x !== null) values.add(String(x));
+      else if ((key === "name" || key === "legal_name") && typeof x === "string") names.add(x);
+    };
+    walk(page);
+    // Synthetic amounts are 4242… markers; ratios and per-share figures are 0.42… / 4.21… markers.
+    const real = [...values].filter((v) => !/^-?(4242\d*|0\.42\d+|4\.21\d+)$/.test(v));
+    check(
+      `${path}: every value is a synthetic marker`,
+      values.size > 0 && real.length === 0,
+      real.slice(0, 5).join(", "),
+    );
+    check(
+      `${path}: issuer is a synthetic SA 99xx symbol`,
+      /^sa:990[123]$/.test(page.company?.company_id ?? ""),
+    );
+    const realNames = [...names].filter((n) => !/Synthetic/.test(n));
+    check(
+      `${path}: every name says Synthetic`,
+      realNames.length === 0,
+      realNames.slice(0, 5).join(", "),
+    );
+    check(`${path}: no ISIN`, page.company?.isin === null);
+  }
+  const baseline = JSON.parse(readFileSync(BASELINE, "utf8"));
+  check(
+    "baseline holds hashes only, no values",
+    baseline.keys.every((k: string) => /^[0-9a-f]{64}$/.test(k)) &&
+      !/"value"\s*:/.test(readFileSync(BASELINE, "utf8")),
+  );
+}
+
+const mode = process.argv[2];
+const run = { pins, trust, scan }[mode as "pins" | "trust" | "scan"];
+if (!run) {
+  console.error("usage: aramco95-kernel-checks.ts <pins|trust|scan>");
+  process.exit(2);
+}
+run();
+for (const [name, ok, detail] of results)
+  console.log(`${ok ? "PASS" : "FAIL"} ${name}${!ok && detail ? ` (${detail})` : ""}`);
+process.exit(results.every(([, ok]) => ok) ? 0 : 1);
diff --git a/.github/workflows/aramco95-kernel.yml b/.github/workflows/aramco95-kernel.yml
new file mode 100644
index 0000000..9c119d2
--- /dev/null
+++ b/.github/workflows/aramco95-kernel.yml
@@ -0,0 +1,137 @@
+# Guards the dormant ARAMCO95 financial projection kernel and its synthetic, sha-pinned test data.
+# Scope: only tests/financial-projection.test.ts and the kernel files; it never runs the whole-repository `bun test`
+# or `eslint .`, so failures of other suites are neither run nor hidden here.
+# Uses no repository secret or environment and grants the token read-only access.
+name: aramco95-kernel
+
+on:
+  pull_request:
+    paths:
+      - ".gitattributes"
+      - ".github/workflows/aramco95-kernel.yml"
+      - ".github/scripts/aramco95-kernel-checks.ts"
+      - "package.json"
+      - "bun.lock"
+      - "tsconfig.json"
+      - "eslint.config.js"
+      - "src/design-fixtures.d.ts"
+      - "src/lib/bidi.ts"
+      - "src/lib/engine/**"
+      - "src/lib/web-v1/design-review-policy.ts"
+      - "src/lib/web-v1/design-fixtures.server.ts"
+      - "src/lib/web-v1/company-experience.ts"
+      - "src/lib/web-v1/catalog.ts"
+      - "src/lib/web-v1/model.ts"
+      - "src/lib/web-v1/display-labels.ts"
+      - "tests/financial-projection.test.ts"
+      - "tests/fixtures/synthetic-projection/**"
+  push:
+    branches: [main]
+    paths:
+      - ".gitattributes"
+      - ".github/workflows/aramco95-kernel.yml"
+      - ".github/scripts/aramco95-kernel-checks.ts"
+      - "package.json"
+      - "bun.lock"
+      - "tsconfig.json"
+      - "eslint.config.js"
+      - "src/design-fixtures.d.ts"
+      - "src/lib/bidi.ts"
+      - "src/lib/engine/**"
+      - "src/lib/web-v1/design-review-policy.ts"
+      - "src/lib/web-v1/design-fixtures.server.ts"
+      - "src/lib/web-v1/company-experience.ts"
+      - "src/lib/web-v1/catalog.ts"
+      - "src/lib/web-v1/model.ts"
+      - "src/lib/web-v1/display-labels.ts"
+      - "tests/financial-projection.test.ts"
+      - "tests/fixtures/synthetic-projection/**"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: aramco95-kernel-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  kernel:
+    name: kernel (${{ matrix.os }})
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, windows-latest]
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 20
+    defaults:
+      run:
+        shell: bash
+    steps:
+      # Git for Windows' default: text files are checked out with CRLF. The pinned files must stay LF regardless.
+      - name: Windows checkout uses core.autocrlf=true
+        if: runner.os == 'Windows'
+        run: git config --global core.autocrlf true
+
+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
+        with:
+          persist-credentials: false
+
+      - name: Windows checkout really converted other text files to CRLF
+        if: runner.os == 'Windows'
+        run: |
+          test "$(git config core.autocrlf)" = "true"
+          grep -q $'\r' src/lib/engine/statements.ts
+
+      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
+        with:
+          bun-version: 1.4.2
+
+      - run: bun install --frozen-lockfile
+
+      - name: Pinned test data is LF and matches its sha256 pins (before any generation)
+        run: bun .github/scripts/aramco95-kernel-checks.ts pins
+
+      - name: Kernel tests (before any generation), exactly 34 passing
+        run: |
+          bun test tests/financial-projection.test.ts 2>&1 | tee kernel-test.log
+          grep -Eq '^ *34 pass' kernel-test.log
+          grep -Eq '^ *0 fail' kernel-test.log
+
+      - name: TypeScript
+        run: bunx tsc --noEmit -p .
+
+      - name: ESLint on the kernel files
+        run: >
+          bunx eslint
+          src/design-fixtures.d.ts src/lib/bidi.ts src/lib/engine
+          src/lib/web-v1/design-review-policy.ts src/lib/web-v1/design-fixtures.server.ts
+          src/lib/web-v1/company-experience.ts src/lib/web-v1/catalog.ts src/lib/web-v1/model.ts
+          src/lib/web-v1/display-labels.ts
+          tests/financial-projection.test.ts tests/fixtures/synthetic-projection/generate.ts
+          .github/scripts/aramco95-kernel-checks.ts
+
+      - name: Build (no secrets)
+        run: bunx vite build
+
+      - name: Generator run 1 changes no file
+        run: |
+          rm -f kernel-test.log
+          bun tests/fixtures/synthetic-projection/generate.ts
+          git diff --exit-code
+          test -z "$(git status --porcelain)"
+
+      - name: Generator run 2 changes no file
+        run: |
+          bun tests/fixtures/synthetic-projection/generate.ts
+          git diff --exit-code
+          test -z "$(git status --porcelain)"
+
+      - name: Pins still hold after generation
+        run: bun .github/scripts/aramco95-kernel-checks.ts pins
+
+      - name: Publication trust store is empty
+        run: bun .github/scripts/aramco95-kernel-checks.ts trust
+
+      - name: No secret, private record or real data in the test data
+        run: bun .github/scripts/aramco95-kernel-checks.ts scan
-- 
2.43.0


From 806544febdead31e7c317bdc370edd6004e5b745 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 11:47:26 +0000
Subject: [PATCH 2/3] CI: lint Windows' CRLF checkout without judging line
 endings

Found by running the workflow on a core.autocrlf=true clone: the prettier
rule reported every CRLF line. Ubuntu still enforces the LF formatting.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CfTpoii6QDStyTPdotmEdY
---
 .github/workflows/aramco95-kernel.yml | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/aramco95-kernel.yml b/.github/workflows/aramco95-kernel.yml
index 9c119d2..d3f3daf 100644
--- a/.github/workflows/aramco95-kernel.yml
+++ b/.github/workflows/aramco95-kernel.yml
@@ -101,9 +101,13 @@ jobs:
       - name: TypeScript
         run: bunx tsc --noEmit -p .
 
+      # On the Windows checkout every source file is CRLF; Ubuntu enforces the committed LF formatting, and the
+      # byte-pinned files are checked separately, so Windows lints the code without judging line endings.
       - name: ESLint on the kernel files
+        env:
+          EOL_RULE: ${{ runner.os == 'Windows' && '{"prettier/prettier":["error",{"endOfLine":"auto"}]}' || '{}' }}
         run: >
-          bunx eslint
+          bunx eslint --rule "$EOL_RULE"
           src/design-fixtures.d.ts src/lib/bidi.ts src/lib/engine
           src/lib/web-v1/design-review-policy.ts src/lib/web-v1/design-fixtures.server.ts
           src/lib/web-v1/company-experience.ts src/lib/web-v1/catalog.ts src/lib/web-v1/model.ts
-- 
2.43.0


From 929e019baf382460c6dd8d38d9a9323eafba9afb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 11:48:47 +0000
Subject: [PATCH 3/3] CI: build after the generator checks so the clean-tree
 check stays exact

On a core.autocrlf=true checkout the build rewrites src/routeTree.gen.ts
with LF; git status then lists it although its content is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CfTpoii6QDStyTPdotmEdY
---
 .github/workflows/aramco95-kernel.yml | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/aramco95-kernel.yml b/.github/workflows/aramco95-kernel.yml
index d3f3daf..2e64e7f 100644
--- a/.github/workflows/aramco95-kernel.yml
+++ b/.github/workflows/aramco95-kernel.yml
@@ -115,9 +115,6 @@ jobs:
           tests/financial-projection.test.ts tests/fixtures/synthetic-projection/generate.ts
           .github/scripts/aramco95-kernel-checks.ts
 
-      - name: Build (no secrets)
-        run: bunx vite build
-
       - name: Generator run 1 changes no file
         run: |
           rm -f kernel-test.log
@@ -139,3 +136,7 @@ jobs:
 
       - name: No secret, private record or real data in the test data
         run: bun .github/scripts/aramco95-kernel-checks.ts scan
+
+      # Last: the build regenerates src/routeTree.gen.ts (LF), which a CRLF checkout reports as modified.
+      - name: Build (no secrets)
+        run: bunx vite build
-- 
