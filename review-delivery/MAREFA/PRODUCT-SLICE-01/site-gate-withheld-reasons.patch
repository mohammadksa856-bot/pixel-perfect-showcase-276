+// Local integration helper (never committed): an ephemeral test authority signs decisions for chosen synthetic
+// engine rows. usage: bun sign_local.ts <page.json> <trust-out.json> <approvals-out.json>
+import { generateKeyPairSync, sign } from "node:crypto";
+import { readFileSync, writeFileSync } from "node:fs";
+import {
+  APPROVALS_SCHEMA,
+  approvalPayload,
+  strictIdentity,
+  strictKey,
+  type Decision,
+} from "./src/lib/engine/publication-gate.server";
+
+const [pagePath, trustOut, approvalsOut] = process.argv.slice(2);
+const page = JSON.parse(readFileSync(pagePath!, "utf8"));
+const { privateKey, publicKey } = generateKeyPairSync("ed25519");
+const FULL: Decision[] = ["SOURCE_ACCEPT", "FINANCIAL_ACCEPT", "PUBLICATION_AUTHORIZED"];
+const plan: [string, string, string, Decision[]][] = [
+  ["annual", "revenue", "2025-12-31", FULL],
+  ["annual", "net_income", "2025-12-31", FULL],
+  ["annual", "operating_cash_flow", "2025-12-31", FULL],
+  ["instant", "total_assets", "2025-12-31", FULL],
+  ["instant", "total_equity", "2025-12-31", FULL],
+  ["annual", "capex", "2025-12-31", ["SOURCE_ACCEPT", "FINANCIAL_ACCEPT"]],
+  ["instant", "total_liabilities", "2025-12-31", ["WITHHELD"]],
+];
+const approvals = [];
+for (const [section, metric, end, decisions] of plan) {
+  const r = page.sections.financials[section].metrics[metric].find(
+    (x: { period_end: string }) => x.period_end === end,
+  );
+  const id = strictIdentity(page.company.company_id, metric, r);
+  if (typeof id === "string") {
+    console.log(`skip ${metric}: ${id}`);
+    continue;
+  }
+  for (const decision of decisions) {
+    const a = {
+      decision,
+      decision_ref: `SLICE-LOCAL-${decision}`,
+      authority_id: "slice-local-test-authority",
+      subject: { kind: "fact" as const, key: strictKey(id) },
+      issued_at: "2026-10-01T00:00:00Z",
+      expires_at: "2027-01-01T00:00:00Z",
+    };
+    approvals.push({
+      ...a,
+      signature: sign(null, Buffer.from(approvalPayload(a)), privateKey).toString("base64"),
+    });
+  }
+}
+writeFileSync(
+  trustOut!,
+  JSON.stringify(
+    {
+      schema: "marefa-publication-trust/1",
+      note: "LOCAL INTEGRATION TEST ONLY — ephemeral key, never committed.",
+      authorities: [
+        {
+          authority_id: "slice-local-test-authority",
+          public_key_spki_der_b64: publicKey
+            .export({ type: "spki", format: "der" })
+            .toString("base64"),
+          decisions: ["SOURCE_ACCEPT", "FINANCIAL_ACCEPT", "PUBLICATION_AUTHORIZED", "WITHHELD"],
+        },
+      ],
+    },
+    null,
+    2,
+  ),
+);
+writeFileSync(approvalsOut!, JSON.stringify({ schema: APPROVALS_SCHEMA, approvals }));
+console.log("signed", approvals.length);
