From 170ad16d628c431c39b27faacf07c4d88cdd6021 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 12:35:37 +0000
Subject: [PATCH] CI: run the ARAMCO95 kernel gate on every pull request and
 push to main

CI-R01: the path filters let a change outside them (vite.config.ts, the
server entry, a new consumer of the kernel, a future dependency) skip the
gate although it can change what the kernel builds into. The workflow now
runs on every pull request, every push to main and on manual dispatch.
Jobs, steps, permissions and pins are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CfTpoii6QDStyTPdotmEdY
---
 .github/workflows/aramco95-kernel.yml | 40 ++-------------------------
 1 file changed, 2 insertions(+), 38 deletions(-)

diff --git a/.github/workflows/aramco95-kernel.yml b/.github/workflows/aramco95-kernel.yml
index d6a74c7..c1b73f3 100644
--- a/.github/workflows/aramco95-kernel.yml
+++ b/.github/workflows/aramco95-kernel.yml
@@ -4,48 +4,12 @@
 # Uses no repository secret or environment and grants the token read-only access.
 name: aramco95-kernel
 
+# No path filters: a change anywhere (vite.config.ts, entry points, a new consumer of the kernel, a dependency)
+# can alter what the kernel ships or how it builds, so every pull request and every push to main runs the gate.
 on:
   pull_request:
-    paths:
-      - ".gitattributes"
-      - ".github/workflows/aramco95-kernel.yml"
-      - ".github/scripts/aramco95-kernel-checks.ts"
-      - "package.json"
-      - "bun.lock"
-      - "tsconfig.json"
-      - "eslint.config.js"
-      - "src/design-fixtures.d.ts"
-      - "src/lib/bidi.ts"
-      - "src/lib/engine/**"
-      - "src/lib/web-v1/design-review-policy.ts"
-      - "src/lib/web-v1/design-fixtures.server.ts"
-      - "src/lib/web-v1/company-experience.ts"
-      - "src/lib/web-v1/catalog.ts"
-      - "src/lib/web-v1/model.ts"
-      - "src/lib/web-v1/display-labels.ts"
-      - "tests/financial-projection.test.ts"
-      - "tests/fixtures/synthetic-projection/**"
   push:
     branches: [main]
-    paths:
-      - ".gitattributes"
-      - ".github/workflows/aramco95-kernel.yml"
-      - ".github/scripts/aramco95-kernel-checks.ts"
-      - "package.json"
-      - "bun.lock"
-      - "tsconfig.json"
-      - "eslint.config.js"
-      - "src/design-fixtures.d.ts"
-      - "src/lib/bidi.ts"
-      - "src/lib/engine/**"
-      - "src/lib/web-v1/design-review-policy.ts"
-      - "src/lib/web-v1/design-fixtures.server.ts"
-      - "src/lib/web-v1/company-experience.ts"
-      - "src/lib/web-v1/catalog.ts"
-      - "src/lib/web-v1/model.ts"
-      - "src/lib/web-v1/display-labels.ts"
-      - "tests/financial-projection.test.ts"
-      - "tests/fixtures/synthetic-projection/**"
   workflow_dispatch:
 
 permissions:
-- 
