+        cashFlow: "3 TEST",
+        margin: "TEST-MARGIN",
+        roic: "TEST-ROIC",
+      },
+    ],
+    quarterlyResults: [
+      {
+        quarter: "Q1 2025",
+        revenue: "4 TEST",
+        profit: "1 TEST",
+        vsEstimate: text,
+        reading: "good",
+      },
+    ],
+    analystConsensus: {
+      rating: text,
+      analystCount: 999,
+      targetPrice: "TEST-TARGET",
+      upside: "TEST-UPSIDE",
+    },
+    valuationScenarios: {
+      bear: { price: "TEST-BEAR" },
+      base: { price: "TEST-BASE" },
+      bull: { price: "TEST-BULL" },
