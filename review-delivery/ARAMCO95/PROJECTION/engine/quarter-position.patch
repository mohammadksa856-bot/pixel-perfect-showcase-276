+    @staticmethod
+    def _fiscal_quarter_end_months(fiscal_year_end: str | None) -> tuple[int, ...]:
+        """Months of the three fiscal quarter ends before the fiscal year end, from an ``MM-DD`` month end.
+
+        The fiscal year end must be the last day of its month (``02-28`` and ``02-29`` both name the end of
+        February); anything else is not a fiscal calendar this method can place, so it returns ``()``.
+        """
+        import calendar
+        import re
+        if not isinstance(fiscal_year_end, str) or not re.fullmatch(r"\d{2}-\d{2}", fiscal_year_end):
+            return ()
+        month, day = (int(x) for x in fiscal_year_end.split("-"))
+        if not 1 <= month <= 12:
+            return ()
+        if day != calendar.monthrange(2001, month)[1] and not (month == 2 and day == 29):
+            return ()
+        return tuple((month + k - 1) % 12 + 1 for k in (3, 6, 9))
+
+    @staticmethod
+    def _fiscal_quarter_end(period_end: str | None, months: tuple[int, ...]):
+        """The date if ``period_end`` is a real ``YYYY-MM-DD`` date on the last day of a fiscal quarter-end month
+        in its own year (February 28 or 29 by leap year), else ``None``. The fiscal year end month is never in
+        ``months``, so year-end balances stay in ``annual_position``."""
+        import calendar
+        import re
+        from datetime import date
+        if not isinstance(period_end, str) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", period_end):
+            return None
+        year, month, day = (int(x) for x in period_end.split("-"))
+        try:
+            value = date(year, month, day)
+        except ValueError:
+            return None
+        if month not in months or day != calendar.monthrange(year, month)[1]:
+            return None
+        return value
+
