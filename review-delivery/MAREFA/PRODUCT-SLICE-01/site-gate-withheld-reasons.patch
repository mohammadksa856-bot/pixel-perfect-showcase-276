diff --git a/tests/publication-withheld-reasons.test.ts b/tests/publication-withheld-reasons.test.ts
new file mode 100644
index 0000000..329831b
--- /dev/null
+++ b/tests/publication-withheld-reasons.test.ts
@@ -0,0 +1,131 @@
+import { describe, expect, test } from "bun:test";
+import { generateKeyPairSync, sign } from "node:crypto";
+import {
+  APPROVALS_SCHEMA,
+  applyPublicationGate,
+  approvalPayload,
+  strictIdentity,
+  strictKey,
+  type Decision,
+  type TrustStore,
+} from "../src/lib/engine/publication-gate.server";
+import { checkRow, type EngineMetricRow } from "../src/lib/engine/company-preview";
+
+const company = "sa:9901";
+const row = (value: string, end: string) => ({
+  display_name: "Revenue",
+  value,
+  value_type: "decimal",
+  currency: "SAR",
+  unit: "SAR",
+  period_start: `${end.slice(0, 4)}-01-01`,
+  period_end: end,
+  period_kind: "fy",
+  scope: "consolidated",
+  dimensions: {},
+  version: 1,
+  source_key: `file:synthetic-${end}`,
+  source_url: "https://example.invalid/synthetic.pdf",
+  provenance: {
+    source: { source_url: "https://example.invalid/synthetic.pdf", filed_at: "2026-03-01" },
+  },
+});
+const page = () => ({
+  contract_version: 4,
+  company: { company_id: company, market: "SA", symbol: "9901", name: "Synthetic" },
+  sections: {
+    financials: {
+      annual: { metrics: { revenue: [row("4242", "2025-12-31"), row("4142", "2024-12-31")] } },
+    },
+  },
+});
+
+const { privateKey, publicKey } = generateKeyPairSync("ed25519");
+const trust: TrustStore = {
+  schema: "marefa-publication-trust/1",
+  authorities: [
+    {
+      authority_id: "test-authority",
+      public_key_spki_der_b64: publicKey.export({ type: "spki", format: "der" }).toString("base64"),
+      decisions: ["SOURCE_ACCEPT", "FINANCIAL_ACCEPT", "PUBLICATION_AUTHORIZED", "WITHHELD"],
+    } as TrustStore["authorities"][number],
+  ],
+};
+const approve = (end: string, decisions: Decision[]) => {
+  const id = strictIdentity(company, "revenue", row(end === "2025-12-31" ? "4242" : "4142", end));
+  if (typeof id === "string") throw new Error(id);
+  return decisions.map((decision) => {
+    const a = {
+      decision,
+      decision_ref: `TEST-${decision}`,
+      authority_id: "test-authority",
+      subject: { kind: "fact" as const, key: strictKey(id) },
+      issued_at: "2026-10-01T00:00:00Z",
+      expires_at: "2027-01-01T00:00:00Z",
+    };
+    return {
+      ...a,
+      signature: sign(null, Buffer.from(approvalPayload(a)), privateKey).toString("base64"),
+    };
+  });
+};
+const now = new Date("2026-10-20T00:00:00Z");
+
+describe("publication gate keeps the reason, never the value, of a withheld row", () => {
+  test("approved row passes; unapproved row becomes a value-less stub with its reason", () => {
+    const approvals = {
+      schema: APPROVALS_SCHEMA,
+      approvals: [
+        ...approve("2025-12-31", ["SOURCE_ACCEPT", "FINANCIAL_ACCEPT", "PUBLICATION_AUTHORIZED"]),
+        ...approve("2024-12-31", ["SOURCE_ACCEPT", "FINANCIAL_ACCEPT"]),
+      ],
+    };
+    const { page: gated, summary } = applyPublicationGate(page() as never, approvals, {
+      mode: "live_engine",
+      now,
+      trust,
+    });
+    const rows = (gated as never as ReturnType<typeof page>).sections.financials.annual.metrics
+      .revenue as Record<string, unknown>[];
+    expect(summary.approved_rows).toBe(1);
+    expect(summary.reasons).toEqual({ no_verified_publication_authorization: 1 });
+    expect(rows.find((r) => r["period_end"] === "2025-12-31")?.["value"]).toBe("4242");
+    const stub = rows.find((r) => r["period_end"] === "2024-12-31")!;
+    expect(stub).toMatchObject({
+      value: null,
+      publication_withheld: "no_verified_publication_authorization",
+      unit: "SAR",
+    });
+    expect(JSON.stringify(stub)).not.toContain("4142");
+    expect("provenance" in stub || "source_url" in stub || "source_key" in stub).toBe(false);
+    expect(checkRow("revenue", stub as EngineMetricRow, "fy")).toBe("publication_not_authorized");
+  });
+
+  test("with no decisions every row is a stub and nothing numeric survives", () => {
+    const { page: gated } = applyPublicationGate(page() as never, null, {
+      mode: "live_engine",
+      now,
+      trust,
+    });
+    const text = JSON.stringify(gated);
+    expect(text).not.toContain("4242");
+    expect(text).not.toContain("4142");
+    const rows = (gated as never as ReturnType<typeof page>).sections.financials.annual.metrics
+      .revenue;
+    expect(rows.map((r) => checkRow("revenue", r as EngineMetricRow, "fy"))).toEqual([
+      "publication_no_source_accept",
+      "publication_no_source_accept",
+    ]);
+  });
+
+  test("the frozen design mode still drops rows instead of stubbing them", () => {
+    const { page: gated } = applyPublicationGate(page() as never, null, {
+      mode: "frozen_design_fixture",
+      now,
+      trust,
+    });
+    expect((gated as never as ReturnType<typeof page>).sections.financials.annual.metrics).toEqual(
+      {},
+    );
+  });
+});
